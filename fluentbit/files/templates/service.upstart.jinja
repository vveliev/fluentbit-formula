description "{{ fluentbit.package.name }} log collection service"

start on started network-services
stop on runlevel [!2345]
setgid nogroup

# Set reasonable file limits
limit nofile 65536 65536

# Restart automatically on crash
respawn

console log

exec /opt/fluent-bit/bin/{{ fluentbit.package.name }} -c {{ fluentbit.config.file }}
